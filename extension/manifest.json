{
    "manifest_version": 3,
    "name": "LocatorLens",
    "version": "1.0.0",
    "description": "Real-time Element Inspector & Locator Builder for Appium (Android & iOS). See app structure, build locators instantly.",
    "permissions": [
        "storage",
        "nativeMessaging"
    ],
    "host_permissions": [
        "http://localhost/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "installers/install_host.sh",
                "installers/install_host.bat",
                "installers/launcher.js"
            ],
            "matches": [
                "chrome-extension://*/*"
            ]
        }
    ]
}